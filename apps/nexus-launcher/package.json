{
  "name": "nexus-launcher",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:ab": "node scripts/ab-check.mjs",
    "release:gate": "node src-tauri/scripts/release-gate.mjs",
    "dev": "vite",
    "test": "node --experimental-strip-types --test --test-concurrency=4 tests/*.test.ts",
    "test:rust": "cargo test --manifest-path ../../Cargo.toml --workspace -j 2 -- --test-threads=4",
    "build": "tsc --noEmit && vite build",
    "prepare:agent": "node src-tauri/scripts/prepare-agent.mjs",
    "prepare:runtime": "node src-tauri/scripts/prepare-runtime.mjs",
    "prepare:release": "node src-tauri/scripts/prepare-release.mjs",
    "verify:release": "node src-tauri/scripts/prepare-release.mjs --verify",
    "test:bundled-runtime": "node --test tests/bundled-runtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare:notices": "node -e \"require('fs').mkdirSync('src-tauri/resources/notices',{recursive:true})\" && pnpm licenses list --prod --json > src-tauri/resources/notices/frontend-input.json && node src-tauri/scripts/prepare-notices.mjs",
    "test:platform": "node --test tests/release-platform.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
