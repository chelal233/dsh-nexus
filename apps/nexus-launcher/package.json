{
  "name": "nexus-launcher",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:ab": "node scripts/ab-check.mjs",
    "release:gate": "node desktop/scripts/release-gate.mjs",
    "dev": "pnpm electron:dev",
    "test": "node --experimental-strip-types --test --test-concurrency=4 tests/*.test.ts",
    "test:rust": "cargo test --manifest-path ../../Cargo.toml --workspace -j 2 -- --test-threads=4",
    "build": "tsc --noEmit && vite build",
    "prepare:agent": "node desktop/scripts/prepare-agent.mjs",
    "prepare:runtime": "node desktop/scripts/prepare-runtime.mjs",
    "prepare:desktop": "node desktop/scripts/prepare-desktop-runtime.mjs",
    "prepare:release": "node desktop/scripts/prepare-release.mjs",
    "verify:release": "node desktop/scripts/prepare-release.mjs --verify",
    "test:bundled-runtime": "node --test tests/bundled-runtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:notices": "node -e \"require('fs').mkdirSync('desktop/resources/notices',{recursive:true})\" && pnpm licenses list --prod --json > desktop/resources/notices/frontend-input.json && node desktop/scripts/prepare-notices.mjs",
    "test:platform": "node --test tests/release-platform.test.mjs",
    "electron:dev": "pnpm build && electron .",
    "electron:build": "pnpm build && electron-builder --config electron-builder.cjs --publish never",
    "test:electron": "node --test tests/electron-*.test.mjs",
    "test:electron-client-audit": "electron scripts/electron-client-audit-e2e.mjs",
    "test:electron-update": "node scripts/electron-update-e2e.mjs",
    "dev:web": "vite"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "electron-updater": "6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "main": "electron/bootstrap.mjs",
  "description": "Nexus desktop control plane",
  "author": "Nexus maintainers"
}
