{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/nexus-agent.exe": "nexus-agent.exe",
      "resources/nexus-launcher.exe": "nexus-launcher.exe",
      "resources/nexusctl.exe": "nexusctl.exe"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installers/shutdown.nsh"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
