<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- The referenced group links this entire fragment into Tauri's product. -->
    <ComponentGroup Id="NexusInstallerShutdown" />
    <Binary Id="NexusStopBinary" SourceFile="$(sys.SOURCEFILEDIR)..\resources\nexus-launcher.exe" />
    <CustomAction Id="NexusStopInstalledAgent"
                  BinaryKey="NexusStopBinary"
                  ExeCommand="installer-stop --install-dir &quot;[INSTALLDIR].&quot;"
                  Execute="immediate" Return="check" />
    <!-- User-profile cleanup remains opt-in. Never prompt on upgrades or
         unattended removal (/passive sets REBOOTPROMPT=S; ARP can use UILevel=3), and never resolve the elevated system profile. -->
    <CustomAction Id="NexusAskDataCleanup"
                  BinaryKey="NexusStopBinary"
                  ExeCommand="installer-cleanup --data-dir &quot;[LocalAppDataFolder]Nexus&quot; --install-dir &quot;[INSTALLDIR].&quot; --locale &quot;[ProductLanguage]&quot;"
                  Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <!-- CostFinalize has resolved INSTALLDIR. Run before validation and
           Tauri's afterInstallInitialize removal of a previous MSI product. -->
      <Custom Action="NexusStopInstalledAgent" Before="InstallValidate">1</Custom>
      <Custom Action="NexusAskDataCleanup" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 3 AND NOT (REBOOTPROMPT="S")</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
