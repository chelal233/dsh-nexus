{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Launcher",
  "version": "0.1.0",
  "identifier": "com.nexus.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:agent && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nexus Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' http://127.0.0.1:* http://localhost:* http://[::1]:*; img-src 'self' data: blob:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "resources/nexus-agent*": "",
      "resources/nexus-launcher*": "",
      "resources/nexusctl*": ""
    },
    "category": "Utility",
    "shortDescription": "Native local control plane for Nexus",
    "longDescription": "A native operator shell for the independent Nexus Agent and immutable Harness runtime.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
